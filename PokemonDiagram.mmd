---
id: a74535a6-efbf-460e-a5fd-bcca80644e5f
---
classDiagram
    direction LR

    class Pokemon["Pokémon"] {
        -str __name
        -Type __type
        -Color __color
        -float __height
        -float __weight
        -int __pokedexNr
        +__init__(name, type, color, height, weight, pokedexNr)
        +get_name() str
        +get_type() Type
        +get_color() Color
        +get_height() float
        +get_weight() float
        +get_pokedexNr() int
        +set_name(name)
        +set_type(type)
        +set_color(color)
        +set_height(height)
        +set_weight(weight)
        +set_pokedexNr(pokedexNr)
        +__str__() str
    }

    class Pokedex["Pokédex"] {
        -list __pokemon_list
        +__init__()
        +get_pokemon_list() list
        +create_Pokémon()
        +show_all_pokemon()
        +update_pokemon()
        +delete_pokemon()
        +sort_pokemon()
    }

    class FileManagement {
        +save_to_file(pokemon_list) bool
        +read_from_file() list
    }

    class Type {
        <<enumeration>>
        Grass = 1
        Fire = 2
        Water = 3
        Flying = 4
        Normal = 5
    }

    class Color {
        <<enumeration>>
        Red = 1
        Green = 2
        Blue = 3
        Grey = 4
        White = 5
    }

    class PokedexApplication["PokédexApplication"] {
        +main()
    }

    Pokedex "1" o-- "0..*" Pokemon : manages
    Pokemon --> Type : has type
    Pokemon --> Color : has color
    PokedexApplication ..> Pokedex : uses
    PokedexApplication ..> FileManagement : uses
    Pokedex ..> Pokemon : creates and manages
    FileManagement ..> Pokemon : saves and reads
